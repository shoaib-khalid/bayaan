{
 "translation": 2,
 "surah": 57,
 "from": 25,
 "to": 29,
 "ayahs": {
  "25": [
   {"from": 1, "to": 4, "until": "اپنے پیغمبروں کو کھلی نشانیاں دے کر بھیجا۔"},
   {"from": 5, "to": 11, "until": "تاکہ لوگ انصاف پر قائم رہیں۔"},
   {"from": 12, "to": 18, "until": "لوگوں کے لئے فائدے بھی ہیں"},
   {"from": 19, "to": 24, "until": "پیغمبروں کی مدد کرتے ہیں اللہ انکو معلوم کرے۔"},
   {"from": 25, "to": 28}
  ],
  "26": [
   {"from": 1, "to": 9, "until": "وقتاً فوقتاً جاری رکھا"},
   {"from": 10, "to": 11, "until": "سو بعض تو ان میں سے ہدایت پر ہیں۔"},
   {"from": 12, "to": 14}
  ],
  "27": [
   {"from": 1, "to": 18, "until": "شفقت اور مہربانی ڈالدی۔"},
   {"from": 19, "to": 23, "until": "ہم نے انکو اس کا حکم نہیں دیا تھا"},
   {"from": 24, "to": 31, "until": "نباہ بھی نہ سکے۔"},
   {"from": 32, "to": 36, "until": "انکو ہم نے ان کا اجر دیا"},
   {"from": 37, "to": 39}
  ],
  "28": [
   {"from": 1, "to": 7, "until": "اسکے پیغمبر پر ایمان لاؤ"},
   {"from": 8, "to": 18, "until": "اور تمکو بخش دے گا"},
   {"from": 19, "to": 21}
  ],
  "29": [
   {"from": 1, "to": 11, "until": "فضل پر کچھ بھی قدرت نہیں رکھتے۔"},
   {"from": 12, "to": 18, "until": "وہ جسکو چاہتا ہے دیتا ہے"},
   {"from": 19, "to": 22}
  ]
 }
}
