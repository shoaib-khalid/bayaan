{
 "translation": 2,
 "surah": 65,
 "from": 1,
 "to": 5,
 "ayahs": {
  "1": [
   {"from": 1, "to": 7, "until": "انکی عدت کو پیش نظر رکھ کر طلاق دو"},
   {"from": 8, "to": 12, "until": "جو تمہارا پروردگار ہے ڈرو۔"},
   {"from": 13, "to": 18, "until": "اور نہ وہ خود ہی نکلیں۔"},
   {"from": 19, "to": 23, "until": "کھلی بے حیائی کریں تو اور بات ہے"},
   {"from": 24, "to": 26, "until": "اور یہ اللہ کی حدیں ہیں"},
   {"from": 27, "to": 33, "until": "وہ اپنے آپ پر ظلم کرے گا"},
   {"from": 34, "to": 41}
  ],
  "2": [
   {"from": 1, "to": 8, "until": "یا اچھی طرح سے علیحدہ کر دو۔"},
   {"from": 9, "to": 15, "until": "اللہ کے لئے درست گواہی دینا۔"},
   {"from": 16, "to": 24, "until": "روز آخرت پر ایمان رکھتا ہے"},
   {"from": 25, "to": 30}
  ],
  "3": [
   {"from": 1, "to": 5, "until": "وہم و گمان بھی نہ ہو۔"},
   {"from": 6, "to": 11, "until": "تو وہ اسکے لئے کافی ہو گا۔"},
   {"from": 12, "to": 15, "until": "پورا کر دیتا ہے۔"},
   {"from": 16, "to": 21}
  ],
  "4": [
   {"from": 1, "to": 11, "until": "تو انکی عدّت تین مہینے ہے"},
   {"from": 12, "to": 14, "until": "انکی عدّت بھی یہی ہے"},
   {"from": 15, "to": 20, "until": "یعنی بچہ جننے تک ہے۔"},
   {"from": 21, "to": 28}
  ],
  "5": [
   {"from": 1, "to": 5, "until": "جو اس نے تم پر نازل کیا ہے"},
   {"from": 6, "to": 14}
  ]
 }
}
