{
 "translation": 2,
 "surah": 57,
 "from": 12,
 "to": 17,
 "ayahs": {
  "12": [
   {"from": 1, "to": 11, "until": "تو ان سے کہا جائے گا کہ تمکو بشارت ہو"},
   {"from": 12, "to": 18, "until": "ان میں تم ہمیشہ رہو گے۔"},
   {"from": 19, "to": 22}
  ],
  "13": [
   {"from": 1, "to": 10, "until": "تمہارے نور سے روشنی حاصل کریں"},
   {"from": 11, "to": 15, "until": "پس وہاں نور تلاش کرو۔"},
   {"from": 16, "to": 20, "until": "جس میں ایک دروازہ ہو گا۔"},
   {"from": 21, "to": 23, "until": "اس میں تو رحمت ہے"},
   {"from": 24, "to": 27}
  ],
  "14": [
   {"from": 1, "to": 4, "until": "تمہارے ساتھ نہ تھے"},
   {"from": 5, "to": 6, "until": "وہ کہیں گے کیوں نہیں تھے۔"},
   {"from": 7, "to": 17, "until": "اللہ کا حکم آ پہنچا"},
   {"from": 18, "to": 20}
  ],
  "15": [
   {"from": 1, "to": 9, "until": "نہ کافروں ہی سے قبول کیا جائے گا"},
   {"from": 10, "to": 13, "until": "کہ وہی تمہارے لائق ہے۔"},
   {"from": 14, "to": 15}
  ],
  "16": [
   {"from": 1, "to": 13, "until": "اسکے سننے کے وقت انکے دل نرم ہو جائیں"},
   {"from": 14, "to": 20, "until": "ان سے پہلے کتابیں دی گئیں تھیں۔"},
   {"from": 21, "to": 25, "until": "تو انکے دل سخت ہو گئے۔"},
   {"from": 26, "to": 28}
  ],
  "17": [
   {"from": 1, "to": 7, "until": "اسکے مرنے کے بعد زندہ کرتا ہے۔"},
   {"from": 8, "to": 13}
  ]
 }
}
