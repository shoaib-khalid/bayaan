 "ayahs": {
  "9": [
   {"from": 1, "to": 7, "until": "تو ان میں صلح کرا دو۔"},
   {"from": 8, "to": 20, "until": "اللہ کے حکم کی طرف رجوع لائے۔"},
   {"from": 21, "to": 30}
  ],
  "11": [
   {"from": 1, "to": 13, "until": "ان سے بہتر ہوں"},
   {"from": 14, "to": 22, "until": "ان سے اچھی ہوں۔"},
   {"from": 23, "to": 28, "until": "ایک دوسرے کا برا نام رکھو۔"},
   {"from": 29, "to": 33, "until": "برا نام رکھنا گناہ ہے۔"},
   {"from": 34, "to": 39}
  ],
  "12": [
   {"from": 1, "to": 7, "until": "بہت گمان کرنے سے پرہیز کرو"},
   {"from": 8, "to": 11, "until": "کہ بعض گمان گناہ ہیں"},
   {"from": 12, "to": 17, "until": "کسی کی غیبت کرے۔"},
   {"from": 18, "to": 24, "until": "اپنے مرے ہوئے بھائی کا گوشت کھائے؟"},
   {"from": 25, "to": 25, "until": "اس سے تو تم ضرور نفرت کرو گے۔"},
   {"from": 26, "to": 31}
  ],
  "13": [
   {"from": 1, "to": 10, "until": "اور تمہاری قومیں اور قبیلے بنائے۔"},
   {"from": 11, "to": 11, "until": "تاکہ ایک دوسرے کو شناخت کرو۔"},
   {"from": 12, "to": 16, "until": "وہ ہے جو زیادہ پرہیزگار ہے۔"},
   {"from": 17, "to": 20}
  ],
  "14": [
   {"from": 1, "to": 3, "until": "دیہاتی کہتے ہیں کہ ہم ایمان لے آئے۔"},
   {"from": 4, "to": 6, "until": "کہدو کہ تم ایمان نہیں لائے"},
   {"from": 7, "to": 9, "until": "بلکہ یوں کہو کہ ہم اسلام لائے ہیں"},
   {"from": 10, "to": 14, "until": "داخل ہی نہیں ہوا۔"},
   {"from": 15, "to": 23, "until": "کچھ کمی نہیں کرے گا۔"},
   {"from": 24, "to": 27}
  ]
 }
