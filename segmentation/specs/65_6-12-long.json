{
 "translation": 2,
 "surah": 65,
 "from": 6,
 "to": 12,
 "ayahs": {
  "6": [
   {"from": 1, "to": 6, "until": "وہیں رکھو جہاں خود رہتے ہو"},
   {"from": 7, "to": 10, "until": "تکلیف نہ دو۔"},
   {"from": 11, "to": 19, "until": "ان کا خرچ دیتے رہو۔"},
   {"from": 20, "to": 24, "until": "انکو ان کی اجرت دیدو"},
   {"from": 25, "to": 27, "until": "پسندیدہ طریق سے موافقت رکھو"},
   {"from": 28, "to": 32}
  ],
  "7": [
   {"from": 1, "to": 5, "until": "اپنی وسعت کے مطابق خرچ کرنا چاہیے"},
   {"from": 6, "to": 13, "until": "وہ اسکے موافق خرچ کرے۔"},
   {"from": 14, "to": 20, "until": "جتنا اسکو دیا ہے"},
   {"from": 21, "to": 25}
  ],
  "8": [
   {"from": 1, "to": 8, "until": "اسکے پیغمبروں کے احکام سے سرکشی کی"},
   {"from": 9, "to": 14}
  ],
  "10": [
   {"from": 1, "to": 5, "until": "سخت عذاب تیار کر رکھا ہے۔"},
   {"from": 6, "to": 11, "until": "اللہ سے ڈرو۔"},
   {"from": 12, "to": 16}
  ],
  "11": [
   {"from": 1, "to": 6, "until": "اللہ کی واضح آیتیں پڑھتے ہیں"},
   {"from": 7, "to": 15, "until": "نکال کر روشنی میں لے آئیں۔"},
   {"from": 16, "to": 20, "until": "اور عمل نیک کرے گا"},
   {"from": 21, "to": 29, "until": "ہمیشہ ہمیشہ ان میں رہیں گے۔"},
   {"from": 30, "to": 34}
  ],
  "12": [
   {"from": 1, "to": 8, "until": "اور ویسی ہی زمینیں بھی۔"},
   {"from": 9, "to": 11, "until": "ان میں اللہ کا حکم اترتا رہتا ہے"},
   {"from": 12, "to": 18, "until": "اللہ ہر چیز پر قادر ہے۔"},
   {"from": 19, "to": 25}
  ]
 }
}
