 "ayahs": {
  "2": [
   {"from": 1, "to": 14, "until": "کتاب و حکمت کی تعلیم دیتے ہیں"},
   {"from": 15, "to": 21}
  ],
  "5": [
   {"from": 1, "to": 7, "until": "اسکے حامل ہونے کا حق ادا نہ کیا"},
   {"from": 8, "to": 11, "until": "جس پر بڑی بڑی کتابیں لدی ہوں۔"},
   {"from": 12, "to": 18, "until": "انکی مثال بری ہے۔"},
   {"from": 19, "to": 23}
  ],
  "6": [
   {"from": 1, "to": 12, "until": "اللہ کے دوست ہو اور دوسرے لوگ نہیں"},
   {"from": 13, "to": 17}
  ],
  "8": [
   {"from": 1, "to": 8, "until": "وہ تو تمہارے سامنے آ کر رہے گی"},
   {"from": 9, "to": 14, "until": "مالک کی طرف لوٹائے جاؤ گے"},
   {"from": 15, "to": 18}
  ],
  "9": [
   {"from": 1, "to": 9, "until": "نماز کے لئے اذان دی جائے"},
   {"from": 10, "to": 15, "until": "خریدوفروخت ترک کر دو"},
   {"from": 16, "to": 21}
  ],
  "10": [
   {"from": 1, "to": 10, "until": "اللہ کا فضل تلاش کرو"},
   {"from": 11, "to": 15}
  ],
  "11": [
   {"from": 1, "to": 9, "until": "خطبے میں کھڑا چھوڑ گئے۔"},
   {"from": 10, "to": 18, "until": "تماشے اور سودے سے کہیں بہتر ہے۔"},
   {"from": 19, "to": 21}
  ]
 }
}
