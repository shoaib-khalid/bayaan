{
 "translation": 2,
 "surah": 63,
 "from": 1,
 "to": 10,
 "ayahs": {
  "1": [
   {"from": 1, "to": 8, "until": "آپ بیشک اللہ کے پیغمبر ہیں"},
   {"from": 9, "to": 12, "until": "درحقیقت تم اسکے پیغمبر ہو"},
   {"from": 13, "to": 17}
  ],
  "4": [
   {"from": 1, "to": 4, "until": "کیا ہی اچھے معلوم ہوتے ہیں"},
   {"from": 5, "to": 8, "until": "تقریر کو توجہ سے سنتے ہو"},
   {"from": 9, "to": 11, "until": "دیواروں سے لگائی گئ ہیں"},
   {"from": 12, "to": 15, "until": "سمجھیں کہ ان پر بلا آئی۔"},
   {"from": 16, "to": 18, "until": "سو ان سے محتاط رہنا۔"},
   {"from": 19, "to": 22}
  ],
  "5": [
   {"from": 1, "to": 10, "until": "تو سر ہلا دیتے ہیں"},
   {"from": 11, "to": 14}
  ],
  "6": [
   {"from": 1, "to": 8, "until": "انکے آگے برابر ہے۔"},
   {"from": 9, "to": 12, "until": "اللہ انکو ہرگز نہ بخشے گا۔"},
   {"from": 13, "to": 18}
  ],
  "7": [
   {"from": 1, "to": 12, "until": "یہاں تک کہ وہ خود بخود بھاگ جائیں۔"},
   {"from": 13, "to": 20}
  ],
  "8": [
   {"from": 1, "to": 9, "until": "ذلیل لوگوں کو وہاں سے نکال باہر کریں گے۔"},
   {"from": 10, "to": 17}
  ],
  "9": [
   {"from": 1, "to": 11, "until": "اللہ کی یاد سے غافل نہ کر دے۔"},
   {"from": 12, "to": 17}
  ],
  "10": [
   {"from": 1, "to": 10, "until": "کسی کی موت آ جائے"},
   {"from": 11, "to": 17, "until": "تھوڑی سی اور مہلت کیوں نہ دی"},
   {"from": 18, "to": 21}
  ]
 }
}
