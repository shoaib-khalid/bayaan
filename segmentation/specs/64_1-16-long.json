{
 "translation": 2,
 "surah": 64,
 "from": 1,
 "to": 16,
 "ayahs": {
  "1": [
   {"from": 1, "to": 8, "until": "سب اللہ کی تسبیح کرتی ہے۔"},
   {"from": 9, "to": 12, "until": "اسی کی تعریف ہے"},
   {"from": 13, "to": 17}
  ],
  "4": [
   {"from": 1, "to": 5, "until": "زمین میں ہے وہ سب جانتا ہے۔"},
   {"from": 6, "to": 10, "until": "اس سے بھی آگاہ ہے۔"},
   {"from": 11, "to": 14}
  ],
  "5": [
   {"from": 1, "to": 10, "until": "سزا کا مزا چکھ لیا"},
   {"from": 11, "to": 13}
  ],
  "6": [
   {"from": 1, "to": 9, "until": "کیا ایک آدمی ہمیں ہدایت کریگا؟"},
   {"from": 10, "to": 13, "until": "اللہ بھی بے نیاز ہو گیا۔"},
   {"from": 14, "to": 16}
  ],
  "7": [
   {"from": 1, "to": 6, "until": "دوبارہ ہرگز نہیں اٹھائے جائیں گے۔"},
   {"from": 7, "to": 14, "until": "وہ تمہیں بتائے جائیں گے۔"},
   {"from": 15, "to": 18}
  ],
  "9": [
   {"from": 1, "to": 7, "until": "وہ نقصان اٹھانے کا دن ہے۔"},
   {"from": 8, "to": 15, "until": "اسکی برائیاں دور کر دے گا"},
   {"from": 16, "to": 24, "until": "ہمیشہ ہمیشہ ان میں رہیں گے"},
   {"from": 25, "to": 27}
  ],
  "11": [
   {"from": 1, "to": 7, "until": "مگر اللہ کے حکم سے"},
   {"from": 8, "to": 12, "until": "وہ اسکے دل کو ہدایت دیتا ہے"},
   {"from": 13, "to": 16}
  ],
  "14": [
   {"from": 1, "to": 10, "until": "سو ان سے بچتے رہو"},
   {"from": 11, "to": 18}
  ],
  "16": [
   {"from": 1, "to": 4, "until": "جہاں تک ہو سکے اللہ سے ڈرو"},
   {"from": 5, "to": 9, "until": "یہ تمہارے حق میں بہتر ہے"},
   {"from": 10, "to": 16}
  ]
 }
}
