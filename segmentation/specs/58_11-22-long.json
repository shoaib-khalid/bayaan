{
 "translation": 2,
 "surah": 58,
 "from": 11,
 "to": 22,
 "ayahs": {
  "11": [
   {"from": 1, "to": 13, "until": "اللہ تمکو کشادگی بخشے گا۔"},
   {"from": 14, "to": 17, "until": "تو اٹھ کھڑے ہوا کرو"},
   {"from": 18, "to": 26, "until": "اللہ ان کے درجے بلند کرے گا۔"},
   {"from": 27, "to": 30}
  ],
  "12": [
   {"from": 1, "to": 11, "until": "کچھ خیرات کر دیا کرو۔"},
   {"from": 12, "to": 15, "until": "پاکیزگی کی بات ہے۔"},
   {"from": 16, "to": 22}
  ],
  "13": [
   {"from": 1, "to": 7, "until": "خیرات کرو ڈر گئے؟"},
   {"from": 8, "to": 13, "until": "اللہ نے تمہیں معاف کر دیا"},
   {"from": 14, "to": 20, "until": "فرمانبرداری کرتے رہو۔"},
   {"from": 21, "to": 24}
  ],
  "14": [
   {"from": 1, "to": 9, "until": "جن پر اللہ کا غضب ہوا۔"},
   {"from": 10, "to": 14, "until": "وہ نہ تم میں ہیں نہ ان میں"},
   {"from": 15, "to": 19}
  ],
  "17": [
   {"from": 1, "to": 9, "until": "نہ اولاد ہی کچھ فائدہ دے گی۔"},
   {"from": 10, "to": 15}
  ],
  "18": [
   {"from": 1, "to": 9, "until": "اسکے سامنے بھی قسمیں کھائیں گے"},
   {"from": 10, "to": 13, "until": "ایسا کرنے سے کام چل جائے گا۔"},
   {"from": 14, "to": 17}
  ],
  "19": [
   {"from": 1, "to": 6, "until": "اللہ کی یاد انکو بھلا دی ہے۔"},
   {"from": 7, "to": 9, "until": "یہ لوگ شیطان کا ٹولہ ہیں"},
   {"from": 10, "to": 15}
  ],
  "22": [
   {"from": 1, "to": 12, "until": "دشمنوں سے دوستی کرتے ہوئے نہ دیکھو گے"},
   {"from": 13, "to": 21, "until": "یا خاندان ہی کے لوگ ہوں"},
   {"from": 22, "to": 29, "until": "اپنے فیض سے انکی مدد کی ہے"},
   {"from": 30, "to": 37, "until": "جن میں وہ ہمیشہ رہیں گے۔"},
   {"from": 38, "to": 42, "until": "اللہ ان سے خوش اور وہ اللہ سے خوش۔"},
   {"from": 43, "to": 45, "until": "یہی لوگ اللہ کی جماعت والے ہیں۔"},
   {"from": 46, "to": 51}
  ]
 }
}
