 "ayahs": {
  "23": [
   {"from": 1, "to": 7, "until": "باپ دادا نے رکھ لئے ہیں۔"},
   {"from": 8, "to": 13, "until": "انکی کوئی سند نازل نہیں کی۔"},
   {"from": 14, "to": 25}
  ],
  "26": [
   {"from": 1, "to": 9, "until": "کچھ بھی فائدہ نہیں دیتی"},
   {"from": 10, "to": 18}
  ],
  "28": [
   {"from": 1, "to": 5, "until": "حالانکہ انکو اسکی کچھ خبر نہیں۔"},
   {"from": 6, "to": 9, "until": "وہ صرف خیال و گمان پر چلتے ہیں"},
   {"from": 10, "to": 16}
  ],
  "30": [
   {"from": 1, "to": 4, "until": "انکے علم کی یہی انتہا ہے۔"},
   {"from": 5, "to": 12, "until": "جو اسکے رستے سے بھٹک گیا"},
   {"from": 13, "to": 16}
  ],
  "31": [
   {"from": 1, "to": 7, "until": "سب اللہ ہی کا ہے"},
   {"from": 8, "to": 12, "until": "انکو ان کے اعمال کا بدلہ دے"},
   {"from": 13, "to": 16}
  ],
  "32": [
   {"from": 1, "to": 7, "until": "بےحیائی کی باتوں سے اجتناب کرتے ہیں۔"},
   {"from": 8, "to": 14, "until": "وہ تمکو خوب جانتا ہے۔"},
   {"from": 15, "to": 18, "until": "جب اس نے تمکو مٹی سے پیدا کیا"},
   {"from": 19, "to": 27, "until": "تو اپنے آپکو پاک صاف نہ جتاؤ۔"},
   {"from": 28, "to": 31}
  ]
 }
}
