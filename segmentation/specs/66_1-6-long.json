 "ayahs": {
  "1": [
   {"from": 1, "to": 8, "until": "تم اس سے کنارہ کشی کیوں کرتے ہو؟"},
   {"from": 9, "to": 11, "until": "اپنی بیویوں کی خوشنودی چاہتے ہو؟"},
   {"from": 12, "to": 14}
  ],
  "3": [
   {"from": 1, "to": 7, "until": "ایک بھید کی بات کہی۔"},
   {"from": 8, "to": 13, "until": "پیغمبر ﷺ کو آگاہ کر دیا"},
   {"from": 14, "to": 18, "until": "کچھ تو جتائی اور کچھ نہ بتائی"},
   {"from": 19, "to": 25, "until": "آپ کو یہ کس نے بتایا؟"},
   {"from": 26, "to": 29}
  ],
  "4": [
   {"from": 1, "to": 7, "until": "تمہارے دل مائل ہو ہی گئے ہیں۔"},
   {"from": 8, "to": 17, "until": "انکے حامی اور دوستدار ہیں"},
   {"from": 18, "to": 21}
  ],
  "5": [
   {"from": 1, "to": 9, "until": "تم سے بہتر بیویاں دیدے۔"},
   {"from": 10, "to": 17}
  ],
  "6": [
   {"from": 1, "to": 10, "until": "آدمی اور پتھر ہونگے"},
   {"from": 11, "to": 14, "until": "تندخو اور سخت گیر فرشتے مقرر ہیں"},
   {"from": 15, "to": 22}
  ]
 }
