  "7": [
   {"from": 1, "to": 10, "until": "دوستی پیدا کر دے۔"},
   {"from": 11, "to": 12, "until": "اور اللہ قادر ہے۔"},
   {"from": 13, "to": 15}
  ],
  "8": [
   {"from": 1, "to": 17, "until": "اللہ تمکو منع نہیں کرتا۔"},
