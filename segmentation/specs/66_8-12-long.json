  "8": [
   {"from": 1, "to": 8, "until": "اللہ کے آگے صاف دل سے توبہ کرو"},
   {"from": 9, "to": 20, "until": "جنکے نیچے نہریں بہ رہی ہیں داخل کرے گا"},
   {"from": 21, "to": 28, "until": "رسوا نہیں کرے گا۔"},
   {"from": 29, "to": 33, "until": "داہنی طرف روشنی کرتا ہوا چل رہا ہو گا"},
   {"from": 34, "to": 40, "until": "ہمیں معاف فرما۔"},
   {"from": 41, "to": 45}
  ],
  "10": [
   {"from": 1, "to": 9, "until": "لوط کی بیوی کی مثال بیان فرمائی ہے۔"},
   {"from": 10, "to": 16, "until": "دونوں نے ان سے خیانت کی"},
   {"from": 17, "to": 22, "until": "کچھ بھی کام نہ آئے"},
   {"from": 23, "to": 27}
  ],
  "11": [
   {"from": 1, "to": 7, "until": "فرعون کی بیوی کی بیان فرمائی"},
   {"from": 8, "to": 16, "until": "اپنے پاس ایک گھر بنا"},
   {"from": 17, "to": 20, "until": "اسکے عمل سے نجات بخش"},
   {"from": 21, "to": 24}
  ],
  "12": [
   {"from": 1, "to": 6, "until": "عزت و ناموس کو محفوظ رکھا۔"},
   {"from": 7, "to": 10, "until": "اپنی روح پھونک دی"},
   {"from": 11, "to": 17}
