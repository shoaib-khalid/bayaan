 "ayahs": {
  "3": [
   {"from": 1, "to": 5, "until": "اسی نے سات آسمان اوپر تلے بنائے۔"},
   {"from": 6, "to": 12, "until": "تخلیق میں کچھ نقص دیکھتا ہے؟"},
   {"from": 13, "to": 18}
  ],
  "8": [
   {"from": 1, "to": 4, "until": "گویا مارے جوش کے پھٹ پڑے گی۔"},
   {"from": 5, "to": 13}
  ],
  "9": [
   {"from": 1, "to": 5, "until": "ضرور خبردار کرنے والا آیا تھا۔"},
   {"from": 6, "to": 12, "until": "کوئی چیز نازل ہی نہیں کی۔"},
   {"from": 13, "to": 18}
  ],
  "15": [
   {"from": 1, "to": 6, "until": "زمین کو ہموار و پست بنایا"},
   {"from": 7, "to": 12, "until": "اللہ کا دیا ہوا رزق کھاؤ"},
   {"from": 13, "to": 14}
  ],
  "19": [
   {"from": 1, "to": 7, "until": "انکو سکیڑ بھی لیتے ہیں۔"},
   {"from": 8, "to": 11, "until": "انہیں کوئی تھام نہیں سکتا۔"},
   {"from": 12, "to": 15}
  ],
  "20": [
   {"from": 1, "to": 10, "until": "رحمٰن کے مقابلے میں تمہاری مدد کر سکے۔"},
   {"from": 11, "to": 15}
  ],
  "27": [
   {"from": 1, "to": 7, "until": "کافروں کے منہ بگڑ جائیں گے۔"},
   {"from": 8, "to": 13}
  ],
  "28": [
   {"from": 1, "to": 9, "until": "یا ہم پر مہربانی کرے۔"},
   {"from": 10, "to": 15}
  ],
  "29": [
   {"from": 1, "to": 7, "until": "اسی پر بھروسا رکھتے ہیں۔"},
   {"from": 8, "to": 13}
  ]
 }
}
