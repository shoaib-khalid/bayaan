{
 "translation": 2,
 "surah": 48,
 "from": 2,
 "to": 15,
 "ayahs": {
  "2": [
   {"from": 1, "to": 9, "until": "تاکہ اللہ تمہاری اگلی اور پچھلی کوتاہیاں بخش دے"},
   {"from": 10, "to": 12, "until": "اور تم پر اپنی نعمت پوری کر دے"},
   {"from": 13, "to": 15}
  ],
  "4": [
   {"from": 1, "to": 11, "until": "تاکہ انکے ایمان کے ساتھ اور ایمان بڑھے"},
   {"from": 12, "to": 15, "until": "اور آسمانوں اور زمین کے لشکر سب اللہ ہی کے ہیں"},
   {"from": 16, "to": 19}
  ],
  "5": [
   {"from": 1, "to": 10, "until": "وہ اس میں ہمیشہ رہیں گے"},
   {"from": 11, "to": 13, "until": "اور تاکہ ان سے انکے گناہوں کو دور کر دے۔"},
   {"from": 14, "to": 19}
  ],
  "6": [
   {"from": 1, "to": 9, "until": "عذاب دے۔"},
   {"from": 10, "to": 12, "until": "انہی پر برے حادثے واقع ہوں۔"},
   {"from": 13, "to": 19, "until": "اور اللہ ان پر غصے ہوا اور ان پر لعنت کی اور انکے لئے دوزخ تیار کی"},
   {"from": 20, "to": 21}
  ],
  "10": [
   {"from": 1, "to": 6, "until": "وہ درحقیقت اللہ سے بیعت کرتے ہیں۔"},
   {"from": 7, "to": 10, "until": "اللہ کا ہاتھ انکے ہاتھوں پر ہے۔"},
   {"from": 11, "to": 16, "until": "پھر جو شخص عہد کو توڑے تو عہد توڑنے کا نقصان اسی کو ہے۔"},
   {"from": 17, "to": 25}
  ],
  "11": [
   {"from": 1, "to": 10, "until": "بخشش مانگیں۔"},
   {"from": 11, "to": 16, "until": "جو انکے دل میں نہیں ہے۔"},
   {"from": 17, "to": 31, "until": "کچھ اختیار رکھے کوئی نہیں"},
   {"from": 32, "to": 37}
  ],
  "12": [
   {"from": 1, "to": 10, "until": "کبھی لوٹ کر آنے ہی کے نہیں۔"},
   {"from": 11, "to": 14, "until": "اچھی معلوم ہوئی۔"},
   {"from": 15, "to": 20}
  ],
  "14": [
   {"from": 1, "to": 4, "until": "اللہ ہی کی ہے۔"},
   {"from": 5, "to": 10, "until": "جسے چاہے سزا دے۔"},
   {"from": 11, "to": 14}
  ],
  "15": [
   {"from": 1, "to": 9, "until": "آپ کے ساتھ چلیں۔"},
   {"from": 10, "to": 14, "until": "بدل دیں۔"},
   {"from": 15, "to": 17, "until": "نہیں چل سکتے۔"},
   {"from": 18, "to": 22, "until": "پہلے سے فرما دیا ہے۔"},
   {"from": 23, "to": 25, "until": "حسد کرتے ہو"},
   {"from": 26, "to": 31}
  ]
 }
}
